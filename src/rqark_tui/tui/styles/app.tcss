Screen {
    background: $rq-bg;
    color: $rq-fg;
}

SessionTabs {
    height: 3;
    border: none;
    padding: 0 2;
    background: transparent;

    & Tab {
        color: $rq-fg-muted;
        background: transparent;

        &:hover {
            color: $rq-fg;
        }

        &.-busy {
            color: $rq-warning;
            text-style: bold;
        }

        &.-active {
            color: $rq-accent;
            text-style: bold;
        }

        &.-add {
            color: $rq-accent;
        }
    }
}

#main-area {
    height: 1fr;
    layers: content overlay;
}

Splash {
    height: 1fr;
    layer: overlay;
    color: $rq-fg-muted;
}

MessagePane {
    height: 1fr;
    layer: content;
    border: none;
    padding: 1 2;
    overflow-x: hidden;
    background: transparent;
}

MessagePane:focus {
    background-tint: transparent;
    border: none;
}

PopupSelector {
    display: none;
    border: round $rq-border;
    background: $rq-surface;
    padding: 0 2;
    height: auto;
    max-height: 10;
    color: $rq-fg;
}

ChatInput {
    border: round $rq-border;
    border-title-color: $rq-fg-muted;
    margin: 0 0;
    padding: 0 2;
    background: transparent;
    color: $rq-fg;
}

ChatInput:focus {
    border: round $rq-accent;
}

StatusBar {
    height: 1;
    padding: 0 2;
    background: transparent;
    color: $rq-fg-muted;
}

StatusBar > .status-line {
    width: 1fr;
    height: 1;
    color: $rq-fg-muted;
}

StatusBar > .status-cloud {
    width: auto;
    height: 1;
    display: none;
    color: $rq-accent;
}

StatusBar.cloud > .status-cloud {
    display: block;
}

YesNoDialog {
    align: center middle;
}

#dialog {
    width: auto;
    max-width: 70%;
    height: auto;
    border: round $rq-accent;
    background: $rq-surface;
    padding: 1 2;
}

#dialog Label {
    color: $rq-fg;
    text-align: center;
    padding: 0 2 1 2;
    width: 100%;
}

#buttons {
    height: auto;
    align: center middle;
}

#buttons Button {
    margin: 1 2;
    min-width: 10;
}

#buttons Button:focus {
    text-style: bold;
    background-tint: $rq-accent 25%;
    outline-left: solid $rq-accent;
    outline-right: solid $rq-accent;
}
